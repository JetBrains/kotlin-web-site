        "next-build-static": "next build --webpack",
        "generate-data": "node scripts/generate-data.mjs",
        "generate-llms-index": "node scripts/llms/generate-llms-index.mjs",
        "generate-redirects": "node scripts/generate-redirect-pages.js",
