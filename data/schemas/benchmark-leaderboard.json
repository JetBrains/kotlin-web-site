{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": [
    "date",
    "rows"
  ],
  "properties": {
    "date": {
      "description": "Publication date of this leaderboard edition, shown under the table.",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notice": {
      "description": "Optional in-progress banner rendered above the ranked rows.",
      "type": "string",
      "minLength": 1
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "setup",
          "submitted",
          "resolved",
          "resolutionRate",
          "tokens",
          "latency",
          "date"
        ],
        "properties": {
          "setup": {
            "type": "string",
            "minLength": 1
          },
          "submitted": {
            "type": "integer",
            "minimum": 1
          },
          "resolved": {
            "type": "integer",
            "minimum": 0
          },
          "resolutionRate": {
            "description": "Already a percentage, not a fraction.",
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "tokens": {
            "description": "Average tokens in millions.",
            "type": "number",
            "minimum": 0
          },
          "latency": {
            "description": "Average latency as \"Hh Mm\"; minutes are not zero-padded.",
            "type": "string",
            "pattern": "^\\d+h \\d{1,2}m$"
          },
          "date": {
            "description": "Evaluation date of this individual run.",
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
